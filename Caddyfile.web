# The single-page app's static files (ADR 0006, epic #199), inside the `web` image, at the root since the cut-over. The
# edge proxy (the bundled caddy service, or the host's own proxy) sends /api/* to the app and everything else here.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# The app's first address, /app/…, until the cut-over: its bookmarks land on the same screen at the root.
	redir /app / 308
	handle_path /app/* {
		redir * {uri} 308
	}

	# Hashed file names: a file never changes, so a browser keeps it.
	handle /assets/* {
		root * /srv/app
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Ruling N1: a file that is not there (a path with an extension) is a 404, never the app's page.
	@file path_regexp \.[A-Za-z0-9]+$
	handle @file {
		root * /srv/app
		file_server
	}

	# Every other path is a screen of the SPA: index.html, read again on each visit so a release shows at once.
	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
