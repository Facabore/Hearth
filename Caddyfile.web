# The single-page app's static files (ADR 0006, epic #199), inside the `web` image. The edge proxy (the bundled caddy
# service, or the host's own proxy) sends /app and /app/* here and everything else to the app.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	redir /app /app/ 308

	# Hashed file names: a file never changes, so a browser keeps it. A missing one is a 404, never the app's page.
	handle /app/assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other app path is a screen of the SPA: index.html, read again on each visit so a release shows at once.
	handle /app/* {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /app/index.html
		file_server
	}

	handle {
		respond 404
	}
}
