{
  "name": "hearth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "spa:dev": "vite --config vite.spa.config.ts",
    "spa:build": "vite build --config vite.spa.config.ts",
    "spa:preview": "vite preview --config vite.spa.config.ts",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pinned": "node scripts/check-pinned.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "test:int": "vitest run --project integration",
    "test:acceptance": "vitest run --project acceptance",
    "test:ops": "vitest run --project operations",
    "test:e2e": "bddgen && playwright test --project e2e --project a11y",
    "perf": "node tests/performance/lighthouse.mjs && playwright test --project perf --workers=1",
    "perf:reports": "vitest run --config vitest.latency.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "use-intl": "4.14.9",
    "uuid": "14.0.3",
    "zod": "4.6.5",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "icu-minify": "4.14.9",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "openapi-typescript": "7.13.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "web-vitals": "6.2.3"
  }
}
