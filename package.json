{
  "name": "hearth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pinned": "node scripts/check-pinned.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "test:int": "vitest run --project integration",
    "test:acceptance": "vitest run --project acceptance",
    "test:ops": "vitest run --project operations"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.3",
    "zod": "4.6.5",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
