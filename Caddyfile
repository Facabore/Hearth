{$HEARTH_DOMAIN} {
	encode zstd gzip
	# ADR 0006 (#199): the API comes from the app. Caddy replaces client-sent X-Forwarded-For with the real peer address
	# (no trusted_proxies set), which the auth rate limiter relies on. The app is reachable only through this proxy.
	@api path /api /api/*
	handle @api {
		reverse_proxy app:3000
	}
	# Everything else is the single-page app, from the web service (its /app/… bookmarks redirect at the root there).
	handle {
		reverse_proxy web:8080
	}
}
